{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "sourceMap": true,
    "outDir": "./dist",
    "types": ["vite/client", "node", "electron"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "forge.config.ts",
    "tsup.config.ts",
    "vite.config.ts",
    "vite.uat.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", "out", "official-web"]
}
