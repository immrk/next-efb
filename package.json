{
  "name": "msfs-desktop-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Electron + React + TypeScript MVP for tracking MSFS aircraft on a map.",
  "main": "dist/electron/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build:bundle": "electron-vite build",
    "clean:release": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (Test-Path 'artifacts') { Remove-Item -LiteralPath 'artifacts' -Recurse -Force }\"",
    "build": "npm run clean:release && npm run build:bundle && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win nsis portable",
    "preview": "electron-vite preview",
    "rebuild-native": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack:dir": "npm run clean:release && npm run build:bundle && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --dir",
    "package:win": "npm run build"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.8.0",
    "i18next": "^25.0.0",
    "leaflet": "^1.9.4",
    "node-simconnect": "^4.0.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.0.0",
    "react-leaflet": "^5.0.0",
    "sonner": "^2.0.7",
    "ws": "^8.20.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.nextflight.msfs-desktop-tracker",
    "productName": "MSFS Desktop Tracker",
    "directories": {
      "output": "artifacts"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
