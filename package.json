{
  "name": "nextefb",
  "version": "0.3.0",
  "private": true,
  "productName": "NextEFB",
  "description": "NextEFB desktop companion for map, chart, and flight-deck workflows.",
  "author": "NextFlight",
  "repository": {
    "type": "git",
    "url": "https://github.com/immrk/next-efb.git"
  },
  "main": "./dist/main/main.js",
  "type": "module",
  "license": "MIT",
  "build": {
    "appId": "com.nextflight.nextefb",
    "productName": "NextEFB",
    "copyright": "Copyright © NextFlight",
    "directories": {
      "output": "out"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "immrk",
        "repo": "next-efb",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "assets/branding/**/*",
      "package.json"
    ],
    "asar": true,
    "electronUpdaterCompatibility": ">=2.16",
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/node-simconnect/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/branding/NextEFB.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NextEFB",
      "installerIcon": "assets/branding/NextEFB.ico",
      "uninstallerIcon": "assets/branding/NextEFB.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    }
  },
  "scripts": {
    "branding:generate": "node scripts/generate-branding.mjs",
    "watch": "nodemon",
    "predev": "npm run build:lan",
    "dev": "node scripts/dev.js",
    "dev:main": "cross-env WINDOW_NAME=main vite",
    "build:lan": "node scripts/rendererBuild.js --only=main",
    "build:renderer": "node scripts/rendererBuild.js",
    "tsup": "tsup",
    "build:main": "node scripts/main.js",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck:main": "tsc --noEmit -p tsconfig.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run typecheck && npm run test:coverage && npm run build",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release:notes": "node scripts/extract-release-notes.mjs",
    "start": "electron ./dist/main/main.js",
    "package": "rimraf out && npm run rebuild-native && npm run build && electron-builder --dir --win --x64 --config.npmRebuild=false",
    "make": "rimraf dist && rimraf out && npm run rebuild-native && npm run build && electron-builder --win nsis --x64 --config.npmRebuild=false --publish never",
    "rebuild-native": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.1",
    "@radix-ui/react-hover-card": "^1.1.18",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-radio-group": "^1.4.2",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@types/ws": "^8.18.1",
    "axios": "^1.10.0",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.8.9",
    "i18next": "^25.3.1",
    "i18next-fs-backend": "^2.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.23.0",
    "node-simconnect": "^4.0.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^15.7.4",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.20.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.0",
    "electron": "^36.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.2",
    "tsup": "^8.5.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.5",
    "vite-plugin-fake-server": "^2.2.0",
    "vitest": "^4.1.10"
  }
}
