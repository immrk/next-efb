{
  "name": "nextefb",
  "version": "0.1.0",
  "private": true,
  "description": "NextEFB desktop companion for map, chart, and flight-deck workflows.",
  "main": "dist/electron/main/main.js",
  "scripts": {
    "branding:generate": "node scripts/generate-branding.mjs",
    "dev": "npm run branding:generate && electron-vite dev",
    "build:bundle": "npm run branding:generate && electron-vite build",
    "clean:release": "node scripts/clean-release.mjs",
    "build": "npm run clean:release && npm run build:bundle && electron-builder --win nsis",
    "build:portable": "npm run clean:release && npm run build:bundle && electron-builder --win portable",
    "preview": "npm run branding:generate && electron-vite preview",
    "rebuild-native": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "uat": "vite --config vite.uat.config.ts",
    "pack:dir": "npm run clean:release && npm run build:bundle && electron-builder --dir",
    "package:win": "npm run build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.8.0",
    "element-plus": "^2.10.3",
    "leaflet": "^1.9.4",
    "node-simconnect": "^4.0.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "vue": "^3.5.17",
    "vue-i18n": "^11.1.9",
    "vue-router": "^4.5.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/leaflet": "^1.9.21",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "electron": "^37.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.0.0",
    "jsdom": "^26.1.0",
    "sass": "^1.89.2",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12"
  },
  "build": {
    "appId": "com.nextflight.nextefb",
    "productName": "NextEFB",
    "artifactName": "NextEFB-${version}-${arch}.${ext}",
    "executableName": "NextEFB",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "artifacts"
    },
    "files": [
      "dist/**/*",
      "assets/branding/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "icon": "assets/branding/NextEFB.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "NextEFB-${version}-${arch}-installer.${ext}",
      "installerIcon": "assets/branding/NextEFB.ico",
      "uninstallerIcon": "assets/branding/NextEFB.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "NextEFB-${version}-${arch}-portable.${ext}"
    }
  }
}
