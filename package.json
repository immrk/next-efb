{
  "name": "nextefb",
  "version": "0.1.0",
  "private": true,
  "description": "NextEFB desktop companion for map, chart, and flight-deck workflows.",
  "author": "Keyajian <keyajian@gmail.com>",
  "main": "./dist/main/main.js",
  "type": "module",
  "license": "ISC",
  "config": {
    "forge": "./forge.config.ts"
  },
  "scripts": {
    "branding:generate": "node scripts/generate-branding.mjs",
    "watch": "nodemon",
    "dev": "node scripts/dev.js",
    "dev:main": "WINDOW_NAME=main vite",
    "dev:setting": "WINDOW_NAME=setting vite",
    "dev:login": "WINDOW_NAME=login vite",
    "build:renderer": "node scripts/rendererBuild.js",
    "start": "electron ./dist/main/main.js",
    "forge:start": "electron-forge start",
    "package": "electron-forge package",
    "tsup": "tsup",
    "build:main": "node scripts/main.js",
    "build": "rimraf dist && npm run build:main && npm run build:renderer",
    "make": "rimraf dist && rimraf out && npm run branding:generate && npm run build:main && npm run build:renderer && electron-forge make",
    "rebuild-native": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "uat": "vite --config vite.uat.config.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.8.0",
    "electron-store": "^10.1.0",
    "element-plus": "^2.10.3",
    "leaflet": "^1.9.4",
    "node-simconnect": "^4.0.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "vue": "^3.5.17",
    "vue-i18n": "^11.1.9",
    "vue-router": "^4.5.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-deb": "^7.8.1",
    "@electron-forge/maker-dmg": "^7.8.1",
    "@electron-forge/maker-rpm": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
    "@electron-forge/plugin-fuses": "^7.8.1",
    "@electron/rebuild": "^4.0.3",
    "@electron/fuses": "^1.8.0",
    "@iconify-json/ep": "^1.2.2",
    "@iconify-json/mdi": "^1.2.3",
    "@types/leaflet": "^1.9.21",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.1.0",
    "dotenv": "^17.2.0",
    "electron": "^36.5.0",
    "esbuild": "^0.28.1",
    "jsdom": "^26.1.0",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.1",
    "sass": "^1.89.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-icons": "^22.1.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^6.3.5",
    "vite-plugin-fake-server": "^2.2.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12"
  }
}
